# Database and server
DATABASE_URL="postgresql://rezervo:rezervo@localhost:5432/rezervo?schema=public"
PORT=4000
WEB_ORIGIN="http://localhost:5173"
API_PUBLIC_URL="http://localhost:4000"
NODE_ENV="development"
JWT_SECRET="replace-with-a-long-random-secret"
COOKIE_SECRET="replace-with-a-second-long-random-secret"

# Transactional email (optional in local development)
EMAIL_PROVIDER="console"
EMAIL_API_KEY=""
EMAIL_FROM="Rezervo <noreply@example.com>"

# Payments are adapter-based. Stripe is intentionally optional.
PAYMENT_PROVIDER="none"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Storage and mapping adapters
STORAGE_PROVIDER="local"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
MAP_PROVIDER="openstreetmap"
MAP_PROVIDER_KEY=""

# Future messaging adapters
SMS_PROVIDER="none"
SMS_PROVIDER_KEY=""
WHATSAPP_PROVIDER="none"
WHATSAPP_PROVIDER_KEY=""
