# Database and server
DATABASE_URL="postgresql://rezervo:rezervo@localhost:5432/rezervo?schema=public"
PORT=4000
WEB_ORIGIN="http://localhost:5173"
API_PUBLIC_URL="http://localhost:4000"
NODE_ENV="development"
JWT_SECRET="replace-with-a-long-random-secret"
COOKIE_SECRET="replace-with-a-second-long-random-secret"

# Transactional email (optional in local development)
EMAIL_PROVIDER="console"
EMAIL_API_KEY=""
EMAIL_FROM="Rezervo <noreply@example.com>"

# Payments are adapter-based. Keep `none` until a full sandbox payment succeeds.
PAYMENT_PROVIDER="none"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENVIRONMENT="sandbox"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Storage and mapping adapters
STORAGE_PROVIDER="local"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
MAP_PROVIDER="openstreetmap"
MAP_PROVIDER_KEY=""

# SMS verification: use `console` locally, or `twilio` with the three fields below.
SMS_PROVIDER="none"
SMS_ACCOUNT_SID=""
SMS_AUTH_TOKEN=""
SMS_FROM=""
WHATSAPP_PROVIDER="none"
WHATSAPP_PROVIDER_KEY=""

# Set to true only for one deployment of a fresh demo database, then set it back to false.
SEED_DEMO_DATA="false"
