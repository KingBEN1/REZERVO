NODE_ENV="production"
PORT="4000"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/rezervo?schema=public"
WEB_ORIGIN="https://www.example.com,https://example.com"
API_PUBLIC_URL="https://api.example.com"
JWT_SECRET="generate-a-unique-64-character-secret"
COOKIE_SECRET="generate-a-second-unique-64-character-secret"

# Use `resend` only after verifying the sender domain in Resend.
EMAIL_PROVIDER="resend"
EMAIL_API_KEY="re_xxxxxxxxxxxxxxxxx"
EMAIL_FROM="Rezervo <noreply@your-domain.com>"
PAYMENT_PROVIDER="none"
# Use cloud object storage before production; local disk is not durable on many hosts.
STORAGE_PROVIDER="local"
SMS_PROVIDER="none"
SMSMODE_API_KEY=""
WHATSAPP_PROVIDER="none"
